<Project>
  <!-- Shared by every project: the next .NET upgrade changes this file (and global.json,
       the Dockerfile tags and .config/dotnet-tools.json), not each .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Microsoft.AspNetCore.* / Microsoft.EntityFrameworkCore.* package version. -->
    <MicrosoftPackagesVersion>10.0.13</MicrosoftPackagesVersion>
  </PropertyGroup>
</Project>
